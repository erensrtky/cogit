{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "type": "object",
      "properties": {
        "goal": {
          "default": "",
          "type": "string",
          "maxLength": 500
        },
        "done": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "pending": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "needsUser": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "text"
            ]
          }
        },
        "next": {
          "default": "",
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "leftOff": {
      "type": "string",
      "maxLength": 400
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "parent": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "phase",
              "message",
              "step",
              "decision",
              "question"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "summary": {
            "type": "string",
            "maxLength": 2000
          },
          "why": {
            "type": "string",
            "maxLength": 2000
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "decidedBy": {
            "type": "string",
            "enum": [
              "user",
              "agent",
              "agreed"
            ]
          },
          "alternatives": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "option": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "why": {
                  "default": "",
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "option"
              ]
            }
          },
          "commits": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            }
          },
          "files": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "links": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}(:[A-Za-z0-9][A-Za-z0-9_.-]{0,127})?$"
            }
          },
          "branch": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "asked": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "outcome": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "open": {
                "default": "",
                "type": "string",
                "maxLength": 300
              }
            },
            "required": [
              "title",
              "asked",
              "outcome"
            ]
          },
          "work": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "agentDecisions": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "why": {
                  "default": "",
                  "type": "string",
                  "maxLength": 500
                },
                "alternatives": {
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "option": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "why": {
                        "default": "",
                        "type": "string",
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "option"
                    ]
                  }
                }
              },
              "required": [
                "title"
              ]
            }
          },
          "shape": {
            "type": "object",
            "properties": {
              "tools": {
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "pseudo",
                        "mermaid",
                        "table",
                        "sequence",
                        "interface",
                        "example",
                        "flow"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ]
                }
              },
              "commits": {
                "default": [],
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{7,40}$"
                }
              }
            },
            "required": [
              "tools"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "title"
        ]
      }
    }
  },
  "required": [
    "sessionId"
  ]
}
