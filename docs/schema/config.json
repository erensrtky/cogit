{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "language": {
      "default": "auto",
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "updateEveryTurns": {
      "default": 15,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "sessionEndCatchUp": {
      "default": true,
      "type": "boolean"
    },
    "recorder": {
      "default": "mixed",
      "type": "string",
      "enum": [
        "agent",
        "mixed",
        "side"
      ]
    },
    "sideModel": {
      "default": "haiku",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sideEveryTurns": {
      "default": 5,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "catchUpModel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "messageSummaries": {
      "default": true,
      "type": "boolean"
    },
    "migrated": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      }
    },
    "shapes": {
      "default": true,
      "type": "boolean"
    },
    "captures": {
      "default": false,
      "type": "boolean"
    },
    "semanticSearch": {
      "default": false,
      "type": "boolean"
    },
    "embeddingModel": {
      "default": "bge-m3",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "startupContext": {
      "default": true,
      "type": "boolean"
    },
    "recordHeadless": {
      "default": false,
      "type": "boolean"
    },
    "serverPort": {
      "default": 4747,
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "shareConversations": {
      "default": false,
      "type": "boolean"
    },
    "trailerMaxAgeHours": {
      "default": 6,
      "type": "integer",
      "minimum": 1,
      "maximum": 8760
    },
    "bigChangeLines": {
      "default": 300,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "inboxMaxAgeDays": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "inbox": {
      "default": true,
      "type": "boolean"
    },
    "agents": {
      "default": [
        "claude-code"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "setupHintOff": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "language",
    "updateEveryTurns",
    "sessionEndCatchUp",
    "recorder",
    "sideModel",
    "sideEveryTurns",
    "messageSummaries",
    "shapes",
    "captures",
    "semanticSearch",
    "embeddingModel",
    "startupContext",
    "recordHeadless",
    "serverPort",
    "shareConversations",
    "trailerMaxAgeHours",
    "bigChangeLines",
    "inboxMaxAgeDays",
    "inbox",
    "agents",
    "setupHintOff"
  ],
  "additionalProperties": false
}
