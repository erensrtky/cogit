#!/usr/bin/env bash
# .start-project/release — SemVer bump + Keep a Changelog kesimi.
# BU dosya `start-project --update` ile yeniden üretilir.
#
#   ./release --auto                commit tiplerinden seviye türet (fix→patch,
#                                   feat→minor) + epic sınırı doğrula (.ralph/
#                                   @fix_plan.md); sınırda değil / [Unreleased]
#                                   boş / feat-fix yok → no-op çıkış
#   ./release --patch|--minor|--major [--force]   elle; --force epic-check atlar
#   ./release --dry-run             ne olacağını yaz, hiçbir dosyaya dokunma
#   ./release --push                commit+tag sonrası `git push --follow-tags`
#
# ATOMİK: `## [Unreleased]` boşsa reddeder; commit/tag patlarsa VERSION +
# CHANGELOG.md pre-run haline geri sarılır. Tag annotated (mesaj = o sürümün
# changelog gövdesi). Push DEFAULT KAPALI. Breaking işareti → otomatik major YOK.
set -u
cd "/home/master/Desktop/www/codelineage" || exit 1

CONF="/home/master/Desktop/www/codelineage/.start-project/release.conf"
# shellcheck source=/dev/null
[ -f "$CONF" ] && . "$CONF"
PREFIX="${RELEASE_TAG_PREFIX:-v}"
VFILE="VERSION"
CL="CHANGELOG.md"

AUTO=0 BUMP="" FORCE=0 DRY=0 PUSH=0
for a in "$@"; do
    case "$a" in
        --auto)    AUTO=1 ;;
        --patch)   BUMP=patch ;;
        --minor)   BUMP=minor ;;
        --major)   BUMP=major ;;
        --force)   FORCE=1 ;;
        --dry-run) DRY=1 ;;
        --push)    PUSH=1 ;;
        *) echo "bilinmeyen seçenek: $a  (--auto | --patch|--minor|--major [--force] | --dry-run | --push)" >&2; exit 2 ;;
    esac
done

[ -f "$VFILE" ] || { echo "✗ VERSION yok — 'start-project --update .'" >&2; exit 1; }
[ -f "$CL" ]    || { echo "✗ CHANGELOG.md yok — 'start-project --update .'" >&2; exit 1; }
cur="$(tr -d '[:space:]' < "$VFILE")"
case "$cur" in
    [0-9]*.[0-9]*.[0-9]*) ;;
    *) echo "✗ VERSION geçersiz: '$cur' (X.Y.Z bekleniyor)" >&2; exit 1 ;;
esac

# ── ## [Unreleased] boş mu? ────────────────────────────────────────────────
# başlıktan sonraki ilk `## ` (ya da EOF) arası; boş satırlar + gövdesiz
# `### Added/...` başlıkları çıkınca en az bir `- ` madde kaldı mı?
unrel="$(awk '
    /^## \[Unreleased\]/ { g=1; next }
    g && /^## /           { exit }
    g                     { print }
' "$CL")"
entries="$(printf '%s\n' "$unrel" \
    | grep -vE '^[[:space:]]*$' \
    | grep -vE '^### (Added|Changed|Deprecated|Removed|Fixed|Security)[[:space:]]*$' \
    | grep -cE '^[[:space:]]*-[[:space:]]+[^[:space:]]' || true)"
# --auto: boş [Unreleased] = NO-OP (ajan her epic sınırında koşar; sadece
# chore/refactor'lu epic meşru olarak boş). Elle bump: boş = HATA.
if [ "${entries:-0}" -eq 0 ]; then
    if [ "$AUTO" = 1 ]; then
        echo "· ## [Unreleased] boş — release atlanıyor (no-op)"
        exit 0
    fi
    echo "✗ ## [Unreleased] boş — yayınlanacak değişiklik yok" >&2
    exit 1
fi

# ── epic sınırı doğrulaması (--auto, --force değilse) ──────────────────────
epic_boundary_ok() {
    local fp=""
    [ -f ".ralph/@fix_plan.md" ] && fp=".ralph/@fix_plan.md"
    [ -z "$fp" ] && [ -f ".ralph/fix_plan.md" ] && fp=".ralph/fix_plan.md"
    [ -n "$fp" ] || return 0   # bmalph yok → sınır kontrolü yok
    python3 - "$fp" <<'PY'
import re, sys
rx = re.compile(r'^\s*-\s*\[( |x|X)\]\s*Story\s+(\d+)\.(\d+)')
st = []
for ln in open(sys.argv[1]):
    m = rx.match(ln)
    if m:
        st.append((m.group(1).lower() == 'x', int(m.group(2))))
if not st:
    sys.exit(0)                       # story yok → geç
done = [e for e in st if e[0]]
if not done:
    sys.exit(1)                       # hiç kapalı story yok
last_epic = done[-1][1]
if [e for e in st if e[1] == last_epic and not e[0]]:
    sys.exit(1)                       # bu epic'te açık story var
sys.exit(0)
PY
}

if [ "$AUTO" = 1 ]; then
    if [ "$FORCE" != 1 ] && ! epic_boundary_ok; then
        echo "· epic sınırında değil — release atlanıyor (no-op)"
        exit 0
    fi
    last_tag="$(git describe --tags --abbrev=0 --match "${PREFIX}[0-9]*" 2>/dev/null || true)"
    subj="$(git log --format='%s%n%b' ${last_tag:+"$last_tag"..}HEAD 2>/dev/null || true)"
    if printf '%s\n' "$subj" | grep -qE '^[a-z]+(\(.+\))?!: |^BREAKING CHANGE:'; then
        echo "! breaking değişiklik tespit edildi — otomatik major YAPILMAZ." >&2
        echo "  hazırsan: ./release --major" >&2
        exit 3
    fi
    if   printf '%s\n' "$subj" | grep -qE '^feat(\(.+\))?: '; then BUMP=minor
    elif printf '%s\n' "$subj" | grep -qE '^fix(\(.+\))?: ';  then BUMP=patch
    else
        echo "· son tag'den beri feat/fix yok — bump atlanıyor (no-op)"
        exit 0
    fi
fi

[ -n "$BUMP" ] || { echo "✗ seviye belirt: --auto | --patch | --minor | --major" >&2; exit 2; }

# ── yeni sürüm ────────────────────────────────────────────────────────────
IFS=. read -r MA MI PA <<EOF
$cur
EOF
case "$BUMP" in
    major) MA=$((MA + 1)); MI=0; PA=0 ;;
    minor) MI=$((MI + 1)); PA=0 ;;
    patch) PA=$((PA + 1)) ;;
esac
new="$MA.$MI.$PA"
today="$(date -u +%F)"
tag="${PREFIX}${new}"

if [ "$DRY" = 1 ]; then
    echo "dry-run:"
    echo "  VERSION  : $cur → $new  ($BUMP)"
    echo "  CHANGELOG: ## [Unreleased] → ## [$new] - $today  (+ yeni boş [Unreleased])"
    echo "  tag      : $tag (annotated), push=$([ "$PUSH" = 1 ] && echo evet || echo hayır)"
    exit 0
fi

if ! git diff --cached --quiet 2>/dev/null; then
    echo "✗ index'te stage'lenmiş değişiklik var — release commit'i sadece VERSION+CHANGELOG içermeli. Önce temizle." >&2
    exit 1
fi

backup="$(mktemp -d)"
cp "$VFILE" "$backup/VERSION"; cp "$CL" "$backup/CHANGELOG.md"
restore() { cp "$backup/VERSION" "$VFILE"; cp "$backup/CHANGELOG.md" "$CL"; rm -rf "$backup"; }

printf '%s\n' "$new" > "$VFILE"
python3 - "$CL" "$new" "$today" <<'PY'
import sys
p, new, today = sys.argv[1], sys.argv[2], sys.argv[3]
lines = open(p).read().splitlines(keepends=True)
out, i, n = [], 0, len(lines)
while i < n:
    out.append(lines[i])
    if lines[i].strip() == "## [Unreleased]":
        i += 1
        body = []
        while i < n and not lines[i].startswith("## "):
            body.append(lines[i]); i += 1
        while body and body[0].strip() == "":
            body.pop(0)
        while body and body[-1].strip() == "":
            body.pop()
        out.append("\n")
        out.append("## [%s] - %s\n" % (new, today))
        out.extend(body)
        out.append("\n")
        continue
    i += 1
open(p, "w").write("".join(out))
PY

tagmsg="$(printf '%s\n\n' "$tag"; awk -v h="## [$new]" '
    index($0, h) == 1 { g = 1; next }
    g && /^## /        { exit }
    g                 { print }
' "$CL")"

if ! git add "$VFILE" "$CL"; then
    echo "✗ git add patladı — geri sarılıyor" >&2; restore; exit 1
fi
if ! git commit -q -m "chore(release): $tag"; then
    echo "✗ git commit patladı — geri sarılıyor" >&2
    git reset -q HEAD -- "$VFILE" "$CL" 2>/dev/null || true
    restore; exit 1
fi
if ! git tag -a --cleanup=whitespace -m "$tagmsg" "$tag"; then
    echo "✗ git tag patladı — release commit'i geri alınıyor" >&2
    git reset -q --hard HEAD~1
    rm -rf "$backup"; exit 1
fi
rm -rf "$backup"
echo "✓ $tag  (VERSION $cur → $new, $BUMP)"
if [ "$PUSH" = 1 ]; then
    git push --follow-tags && echo "✓ push edildi" || echo "! push başarısız — elle: git push --follow-tags" >&2
else
    echo "  sıradaki: git push --follow-tags"
fi
