#!/usr/bin/env bash
set -e
cd "/home/master/Desktop/www/codelineage"

# ── Ralph mode: full agent loop with snapshot, graph, notification ──────────
# (Tek atımlık sandboxed Claude için: ./cli veya `start-project cli`)

# ── QA gate ön-kontrol ────────────────────────────────────────────────────
# İlk story'den ÖNCE (stack henüz kurulmadı) lint/typecheck/unit'in boş olması
# normal — ama en az bir story zaten kapandıysa ve hâlâ üçü de boşsa, Ralph'in
# "block" gate'i kördür: ./qa sessizce "geçti" der, hiçbir kod kontrol edilmez.
# Bunu sessizce geçiştirmek yerine dur. Bilerek geçmek istiyorsan: ALLOW_EMPTY_QA=1
if [ -x "/home/master/Desktop/www/codelineage/.start-project/qa" ] && [ -f "/home/master/Desktop/www/codelineage/.ralph/@fix_plan.md" ] \
   && [ -z "${ALLOW_EMPTY_QA:-}" ]; then
    DONE_STORIES=$(grep -cE '^[[:space:]]*- \[[xX]\]' "/home/master/Desktop/www/codelineage/.ralph/@fix_plan.md" 2>/dev/null || echo 0)
    if [ "$DONE_STORIES" -gt 0 ]; then
        EMPTY_STAGES=$("/home/master/Desktop/www/codelineage/.start-project/qa" --list --only=lint,typecheck,unit 2>/dev/null | grep -c '(yapılandırılmamış)' || echo 0)
        if [ "$EMPTY_STAGES" -ge 3 ]; then
            echo ""
            echo "✗ QA gate BOŞ (lint/typecheck/unit hiçbiri yapılandırılmamış) ama $DONE_STORIES story zaten kapanmış."
            echo "  Ralph'in 'block' gate'i şu an körkörüne 'geçti' diyor — hiçbir kod kontrol edilmiyor."
            echo "  Düzelt : start-project qa rescan \"/home/master/Desktop/www/codelineage\""
            echo "  Bilerek geçmek istiyorsan: ALLOW_EMPTY_QA=1 ./run"
            exit 1
        fi
    fi
fi

# Pre-run snapshot
if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    git add -A
    git commit -q -m "chore: pre-run snapshot $(date +%Y%m%d-%H%M%S)"
fi
PRE_RUN_SHA=$(git rev-parse HEAD 2>/dev/null || echo "")
COMMITS_BEFORE=$(git rev-list --count HEAD 2>/dev/null || echo "0")
[ -n "$PRE_RUN_SHA" ] && echo "Snapshot: ${PRE_RUN_SHA:0:8}  (geri almak için: git reset --hard $PRE_RUN_SHA)"

SBHOME="/home/master/Desktop/www/codelineage/.sandbox"
mkdir -p "$SBHOME/.cache" "$SBHOME/.npm" "$SBHOME/.config"

# Provider yönlendirme (opsiyonel): .start-project/provider.env varsa env'e al.
# Yoksa → Claude Code neyse o (abonelik). bwrap --clearenv kullanmiyor → gecer.
if [ -f "/home/master/Desktop/www/codelineage/.start-project/provider.env" ]; then
    set -a; . "/home/master/Desktop/www/codelineage/.start-project/provider.env"; set +a
fi
# Ralph-only override (start-project provider <ad>): SADECE ./run source eder.
# ./cli source ETMEZ → başka terminalde düz CC aboneliğiyle paralel çalışılır.
# provider.env'den SONRA → çakışırsa bu kazanır.
if [ -f "/home/master/Desktop/www/codelineage/.start-project/provider.ralph.env" ]; then
    set -a; . "/home/master/Desktop/www/codelineage/.start-project/provider.ralph.env"; set +a
fi

set +e
# lucid runtime (rw) + pnpm store + user bus — sandbox içinden
# systemctl --user / ~/.lucid config erişimi.
# NOT: --unshare-pid YOK — systemd farklı pid-namespace'ten gelen
# istemcileri reddeder; bus erişimi için pid izolasyonu kaldırıldı.
# ~/.ssh maskelendi (bos tmpfs): --ro-bind / / ile tum host FS zaten okunabilir
# oluyor, ham SSH ozel anahtarlari otonom ajanin gorus alanindan cikariliyor.
# git push/pull KIRILMAZ — kimlik dogrulama zaten /run/user/$UID uzerindeki
# ssh-agent'a (gcr-ssh-agent/GNOME Keyring) gidiyor, ham anahtar dosyasi
# okumuyor.
bwrap \
  --ro-bind / / \
  --tmpfs "$HOME/.ssh" \
  --bind "/home/master/Desktop/www/codelineage" "/home/master/Desktop/www/codelineage" \
  --bind /tmp /tmp \
  --bind "$SBHOME/.config" "$HOME/.config" \
  --bind "$SBHOME/.npm" "$HOME/.npm" \
  --bind "$SBHOME/.cache" "$HOME/.cache" \
  --bind "$HOME/.claude" "$HOME/.claude" \
  --bind-try "$HOME/.claude.json" "$HOME/.claude.json" \
  --dev /dev \
  --proc /proc \
  --unshare-pid \
  --die-with-parent \
  -- bash -c "cd /home/master/Desktop/www/codelineage && SESSION_CONTINUITY=false bmalph run"
EXIT_CODE=$?
set -e

COMMITS_AFTER=$(git rev-list --count HEAD 2>/dev/null || echo 0)
NEW_COMMITS=$(( COMMITS_AFTER - COMMITS_BEFORE ))
CHANGED_FILES=$([ "$NEW_COMMITS" -gt 0 ] && git diff --name-only "HEAD~${NEW_COMMITS}" HEAD 2>/dev/null | wc -l || echo 0)

echo ""
echo "──────────────────────────────────"
echo "Agent bitti."
echo "  Yeni commit : $NEW_COMMITS"
echo "  Değişen dosya: $CHANGED_FILES"
if [ "$NEW_COMMITS" -gt 0 ]; then
    echo ""
    git log --oneline -${NEW_COMMITS} HEAD
    [ -n "$PRE_RUN_SHA" ] && echo "" && echo "  Tümünü geri al: git reset --hard $PRE_RUN_SHA"
fi
echo "──────────────────────────────────"

GRAPH_MODE="fast"
if [ "$GRAPH_MODE" != "no" ]; then
    if ! command -v graphify &>/dev/null; then
        echo "! graphify bulunamadi, graph guncellenemiyor."
        GRAPH_MODE="no"
    elif [ ! -f "/home/master/Desktop/www/codelineage/.graphifyignore" ]; then
        echo "! .graphifyignore bulunamadi, graph guncellenemiyor."
        GRAPH_MODE="no"
    fi
fi

# `graphify update` BURADA YOK — post-commit hook zaten HER commit'te
# (agent'ın attığı dahil) kendi flock'lu arka plan update'ini tetikliyor.
# İkisi eskiden koordinasyonsuz aynı graphify-out/'a paralel yazabiliyordu.
# Sadece HTML export'u burada — o post-commit hook'ta yok, tekrar yazan
# ikinci bir "update" değil, mevcut graph.json'dan üretilen bir görünüm.
if [ "$GRAPH_MODE" != "no" ]; then
    graphify export html 2>/dev/null && echo "Graph hazir: .graphify/graph.html" || true
fi

if command -v notify-send &>/dev/null; then
    notify-send "Agent bitti" "$NEW_COMMITS commit, $CHANGED_FILES dosya — /home/master/Desktop/www/codelineage" --icon=terminal 2>/dev/null || true
fi

if [ -f ".ralph/@fix_plan.md" ]; then
    TOTAL=$(grep -cE '^[[:space:]]*- \[[ xX]\]' .ralph/@fix_plan.md 2>/dev/null || echo 0)
    DONE=$(grep -cE '^[[:space:]]*- \[[xX]\]' .ralph/@fix_plan.md 2>/dev/null || echo 0)
    if [ "$TOTAL" -gt 0 ] && [ "$TOTAL" -eq "$DONE" ]; then
        echo ""
        echo "  ╔══════════════════════════════════════╗"
        echo "  ║  Tum story'ler tamamlandi ($DONE/$TOTAL) ║"
        echo "  ║  Arsivlemek icin:                     ║"
        echo "  ║  @fix_plan.md → @fix_plan.archive.md   ║"
        echo "  ╚══════════════════════════════════════╝"
    fi
fi

exit $EXIT_CODE
