{
  "name": "cogit-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build -w template && npm run build -w cogit",
    "dev:template": "npm run dev -w template",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p packages/cli --noEmit && tsc -p packages/template --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
