{
  "name": "cogit",
  "version": "0.12.0",
  "description": "Git remembers what changed. cogit remembers why.",
  "license": "MIT",
  "keywords": [
    "git",
    "ai",
    "coding-agent",
    "claude-code",
    "history",
    "lineage",
    "commit",
    "context"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sainthardrock/cogit.git"
  },
  "homepage": "https://github.com/sainthardrock/cogit#readme",
  "bugs": {
    "url": "https://github.com/sainthardrock/cogit/issues"
  },
  "type": "module",
  "bin": {
    "cogit": "dist/cli.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "skills",
    "hooks"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prebuild": "node ../../scripts/sync-version.mjs",
    "build": "tsup",
    "prepack": "node ../../scripts/sync-version.mjs && node ../../scripts/copy-docs.mjs"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.4",
    "commander": "^15.0.0",
    "tsup": "^9.0.0",
    "zod": "^4.6.7"
  }
}
